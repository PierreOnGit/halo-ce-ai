    "0": {
      "uid": 0,
      "key": [],
      "keysecondary": [],
      "comment": "Find an action",
      "content": "QUERY: the way you reach every other action. Set target to a plain description of what you are trying to do ('follow the player', 'hold this position', 'get in the vehicle', 'charge the enemy') and you get back the real actions that match, with their exact verbs. Then emit one of those. No action is available until you find it here first.",
      "constant": false,
      "vectorized": false,
      "selective": false,
      "order": 100,
      "position": 0,
      "disable": false,
      "actionId": "chasm.find_action",
