diff --git a/port/linux/src/dsound_sdl.c b/port/linux/src/dsound_sdl.c
index 01fb4f1..2d644fa 100644
--- a/port/linux/src/dsound_sdl.c
+++ b/port/linux/src/dsound_sdl.c
@@ -49,6 +49,7 @@ skips opening a device; audio.channels chooses stereo or 5.1
 #include "sdl_platform.h"
 #include "port_config.h"
 #include "voice_audio.h"
+#include "chasm_client.h"
 
 #include <SDL3/SDL.h>
 #include <math.h>
@@ -1514,8 +1515,8 @@ static void mix(float *output, unsigned long frames)
 		if ((!enabled && reverb.level <= 0.0f) || reverb.quiet > REVERB_QUIET_FRAMES)
 			reverb_clear();
 	}
-	/* the players' voices (voice_audio.c), dry, under the limiter; on 5.1
-	from the front pair */
+	/* the players' voices (voice_audio.c) and the characters' (chasm_client.c),
+	dry, under the limiter; on 5.1 from the front pair */
 	if (output_channels == 6)
 	{
 		float voices[MIX_CHUNK_FRAMES * OUTPUT_CHANNELS];
@@ -1523,6 +1524,7 @@ static void mix(float *output, unsigned long frames)
 
 		memset(voices, 0, frames * OUTPUT_CHANNELS * sizeof(float));
 		voice_audio_mix(voices, frames);
+		chasm_client_mix(voices, frames);
 		for (frame = 0; frame < frames; frame++)
 		{
 			output[frame * 6] += voices[frame * 2];
@@ -1532,6 +1534,7 @@ static void mix(float *output, unsigned long frames)
 	else
 	{
 		voice_audio_mix(output, frames);
+		chasm_client_mix(output, frames);
 	}
 	limit(output, frames);
 }
