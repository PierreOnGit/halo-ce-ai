+int halo_talk_to_ai_held(void)
+{
+	struct platform_input_state input;
+	int slot;
+
+	bindings_read();
+	platform_input_read(&input, FALSE);
+	for (slot = 0; slot < MAXIMUM_BINDINGS; slot++)
+	{
+		if (input_held(&input, bindings[HALO_KEYBOARD_TALK_TO_AI][slot]))
+			return 1;
+	}
+	return 0;
+}
