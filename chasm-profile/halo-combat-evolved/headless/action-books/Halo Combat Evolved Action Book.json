    "targetGame": "halo-combat-evolved",
    "llmMayUseCommandTemplates": false,
    "runtimeRequiresAllowlist": true
  },
  "extensions": {
    "chasm": {
      "type": "action-book",
      "version": 1
    }
  },
  "binding": {
    "engine": "opence:chasm_bridge",
    "adapter": "opence",
    "executor": "chasm_bridge.c chasm_act",
    "protocol": "chasm.action-book.execution.v1",
    "version": 1
  },
